[Unit]
Description=Gemma 4 E2B Q4_0 CPU fallback for the FreeToken arbiter
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/random/dev/huggingvoice-llm-bench/models/gemma4-e2b/gemma-4-E2B_q4_0-it.gguf

[Service]
Type=simple
WorkingDirectory=/home/random/dev/qwen/freetoken
ExecStart=/opt/llama-cpp/bin/llama-server.real \
  --model /home/random/dev/huggingvoice-llm-bench/models/gemma4-e2b/gemma-4-E2B_q4_0-it.gguf \
  --alias gemma-4-e2b \
  --host 127.0.0.1 \
  --port 19193 \
  --ctx-size 4096 \
  --gpu-layers 0 \
  --fit off \
  --flash-attn off \
  --parallel 1 \
  --batch-size 2048 \
  --ubatch-size 512 \
  --threads 6 \
  --threads-batch 6 \
  --cache-ram 1024 \
  --cache-prompt \
  --reasoning off \
  --reasoning-budget 0 \
  --metrics \
  --no-ui \
  --perf
Restart=on-failure
RestartSec=3
TimeoutStartSec=300
TimeoutStopSec=90
KillSignal=SIGTERM

